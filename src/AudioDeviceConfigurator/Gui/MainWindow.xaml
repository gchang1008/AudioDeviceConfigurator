<Window x:Class="AudioDeviceConfigurator.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioDeviceConfigurator" Height="430" Width="620"
        AutomationProperties.AutomationId="AudioDeviceConfigurator.MainWindow">
    <Window.Resources>
        <Style x:Key="SwitchOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayText}" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Playback endpoint" Margin="0,0,0,4" />
        <ComboBox Grid.Row="1" x:Name="EndpointCombo"
                  AutomationProperties.AutomationId="EndpointCombo"
                  IsEnabled="{Binding CanChangeSelection}"
                  DisplayMemberPath="FriendlyName"
                  SelectionChanged="EndpointCombo_OnSelectionChanged">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding EndpointId}" />
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Speaker Channels" Margin="0,10,0,4" />
        <ItemsControl Grid.Row="3" x:Name="ChannelsSwitchGroup"
                      AutomationProperties.AutomationId="ChannelsSwitchGroup"
                      ItemsSource="{Binding ChannelOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding DisplayText}" GroupName="SpeakerChannels"
                                 Style="{StaticResource SwitchOptionStyle}"
                                 Checked="ChannelOption_OnChecked" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="4" Text="Sample Rate" Margin="0,6,0,4" />
        <ItemsControl Grid.Row="5" x:Name="SampleRateSwitchGroup"
                      AutomationProperties.AutomationId="SampleRateSwitchGroup"
                      ItemsSource="{Binding SampleRateOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding DisplayText}" GroupName="SampleRate"
                                 Style="{StaticResource SwitchOptionStyle}"
                                 Checked="SampleRateOption_OnChecked" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="6" Text="Bit Depth" Margin="0,6,0,4" />
        <ItemsControl Grid.Row="7" x:Name="BitDepthSwitchGroup"
                      AutomationProperties.AutomationId="BitDepthSwitchGroup"
                      ItemsSource="{Binding BitDepthOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding DisplayText}" GroupName="BitDepth"
                                 Style="{StaticResource SwitchOptionStyle}"
                                 Checked="BitDepthOption_OnChecked" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="8" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="ApplyButton" Content="Apply" Click="ApplyButton_OnClick"
                        AutomationProperties.AutomationId="ApplyButton"
                        IsEnabled="{Binding CanApply}" />
                <Button x:Name="PlayButton" Content="Play" Click="PlayButton_OnClick"
                        AutomationProperties.AutomationId="PlayButton"
                        IsEnabled="{Binding CanPlay}" />
                <Button x:Name="StopButton" Content="Stop" Click="StopButton_OnClick"
                        AutomationProperties.AutomationId="StopButton"
                        IsEnabled="{Binding CanStop}" />
            </StackPanel>
            <TextBlock Grid.Row="1" x:Name="StatusText" VerticalAlignment="Bottom"
                       AutomationProperties.AutomationId="StatusText"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
