<Window x:Class="AudioDeviceConfigurator.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioDeviceConfigurator" Height="380" Width="506" ResizeMode="NoResize"
        FontFamily="Segoe UI" Background="#FAFAF9" Foreground="#0F1419"
        AutomationProperties.AutomationId="AudioDeviceConfigurator.MainWindow">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0E7C66" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7F2EF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5C6770" />
        <SolidColorBrush x:Key="RuleBrush" Color="#D2D5D7" />

        <!-- GroupBox: flat header with muted label, lighter border -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="White" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  ContentSource="Content" />
                            </Border>
                            <Border IsHitTestVisible="False"
                                    Background="#FAFAF9"
                                    Padding="6,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="10,-7,0,0">
                                <TextBlock Text="{TemplateBinding Header}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButton: custom bullet + tight spacing, hover/active feedback -->
        <Style x:Key="SwitchOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="6,3,0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayText}" />
            <Setter Property="Foreground" Value="#2C333A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BulletRing"
                                                            Storyboard.TargetProperty="(Ellipse.Stroke).(SolidColorBrush.Color)"
                                                            To="#0E7C66" Duration="0:0:0.12" />
                                            <ColorAnimation Storyboard.TargetName="Label"
                                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                            To="#0F1419" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BulletRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.35" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Label"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BulletDot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                            <ColorAnimation Storyboard.TargetName="Label"
                                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                            To="#0F1419" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BulletDot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="BulletRing"
                                             Width="13" Height="13"
                                             Stroke="#A8AEB2" StrokeThickness="1.5"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="BulletDot"
                                             Width="7" Height="7"
                                             Fill="{StaticResource AccentBrush}"
                                             Opacity="0"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Grid>
                                <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox: lighter, with subtle border -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Button: less chrome, accent on primary -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F4F4F2" />
            <Setter Property="Foreground" Value="#0F1419" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Playback endpoint"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
        <ComboBox Grid.Row="1" x:Name="EndpointCombo"
                  AutomationProperties.AutomationId="EndpointCombo"
                  IsEnabled="{Binding CanChangeSelection}"
                  DisplayMemberPath="FriendlyName"
                  SelectionChanged="EndpointCombo_OnSelectionChanged">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding EndpointId}" />
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Speaker Channels" Margin="0,0,6,0">
                <ItemsControl x:Name="ChannelsSwitchGroup"
                              AutomationProperties.AutomationId="ChannelsSwitchGroup"
                              ItemsSource="{Binding ChannelOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding DisplayText}" GroupName="SpeakerChannels"
                                         Style="{StaticResource SwitchOptionStyle}"
                                         Checked="ChannelOption_OnChecked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Sample Rate" Margin="3,0,3,0">
                <ItemsControl x:Name="SampleRateSwitchGroup"
                              AutomationProperties.AutomationId="SampleRateSwitchGroup"
                              ItemsSource="{Binding SampleRateOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding DisplayText}" GroupName="SampleRate"
                                         Style="{StaticResource SwitchOptionStyle}"
                                         Checked="SampleRateOption_OnChecked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Bit Depth" Margin="6,0,0,0">
                <ItemsControl x:Name="BitDepthSwitchGroup"
                              AutomationProperties.AutomationId="BitDepthSwitchGroup"
                              ItemsSource="{Binding BitDepthOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding DisplayText}" GroupName="BitDepth"
                                         Style="{StaticResource SwitchOptionStyle}"
                                         Checked="BitDepthOption_OnChecked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="ApplyButton" Content="Apply" Click="ApplyButton_OnClick"
                            AutomationProperties.AutomationId="ApplyButton"
                            IsEnabled="{Binding CanApply}"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            BorderBrush="{StaticResource AccentBrush}" />
                    <Button x:Name="PlayButton" Content="Play" Click="PlayButton_OnClick"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="PlayButton"
                            IsEnabled="{Binding CanPlay}" />
                    <Button x:Name="StopButton" Content="Stop" Click="StopButton_OnClick"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="StopButton"
                            IsEnabled="{Binding CanStop}" />
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="StatusText" VerticalAlignment="Bottom"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           AutomationProperties.AutomationId="StatusText"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Grid>
            <GroupBox Grid.Column="1" Header="Active"
                      AutomationProperties.AutomationId="ActiveSettingsGroup"
                      Margin="8,0,0,0" VerticalAlignment="Bottom"
                      MinWidth="160">
                <StackPanel>
                    <TextBlock AutomationProperties.AutomationId="ActiveChannelText"
                               Text="{Binding ActiveChannelDisplay, Mode=OneWay}"
                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" />
                    <TextBlock AutomationProperties.AutomationId="ActiveSampleRateText"
                               Text="{Binding ActiveSampleRateDisplay, Mode=OneWay}"
                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" />
                    <TextBlock AutomationProperties.AutomationId="ActiveBitDepthText"
                               Text="{Binding ActiveBitDepthDisplay, Mode=OneWay}"
                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" />
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>